# ============================================================
# CircuitKart Environment Variables
# ============================================================

# ------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel / Local)
# ------------------------------------------------------------
# In Vercel Project Settings -> Environment Variables, set:
# VITE_API_BASE_URL=https://your-backend-app.onrender.com
#
# (Alternatively VITE_API_URL is also supported)
# For local development with Vite dev proxy to localhost:3001, leave empty or:
VITE_API_BASE_URL=
VITE_API_URL=

# ------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render / Local)
# ------------------------------------------------------------
# In Render Service Settings -> Environment Variables, set:
PORT=3001
NODE_ENV=production
JWT_SECRET=circuitkart-production-super-secret-key-change-this
CLIENT_URL=https://sellproject-wv5s.vercel.app
